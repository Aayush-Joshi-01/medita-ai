# Copy this file to `.env` and fill in real values before running
# `docker compose up`. Never commit the resulting `.env` file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ENV=development
# Required — the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------------------------------------------------------------------------
# PostgreSQL (app database + a separate FHIR database for HAPI)
# ---------------------------------------------------------------------------
POSTGRES_USER=medita
POSTGRES_PASSWORD=medita
POSTGRES_DB=medita
POSTGRES_FHIR_DB=medita_fhir
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://medita:medita@db:5432/medita

# ---------------------------------------------------------------------------
# Redis (job queue + cache)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Qdrant (vector store)
# ---------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=medita_documents

# ---------------------------------------------------------------------------
# MinIO / S3-compatible object storage
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=medita
MINIO_ROOT_PASSWORD=medita12345
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_MEDIA_BUCKET=medita-media
MINIO_DOCS_BUCKET=medita-docs

# ---------------------------------------------------------------------------
# LiteLLM gateway — application code calls these logical model names only.
# ---------------------------------------------------------------------------
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-medita-local-master-key
LITELLM_MODEL_CHAT=chat-default
LITELLM_MODEL_VISION=vision-default
LITELLM_MODEL_EMBED=embed-default

# Provider keys consumed by the litellm container (infra/litellm/config.yaml).
# Leave a key blank if you are not routing to that provider.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# HAPI FHIR
# ---------------------------------------------------------------------------
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir

# ---------------------------------------------------------------------------
# Backend CORS (comma-separated origins allowed to call the API directly)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=medita-ai

# ---------------------------------------------------------------------------
# Observability / dev tools
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
